# Copy to .env (it is in .gitignore) and fill in locally. Never commit it.
# Everything here is optional: the first-run setup in the dashboard (http://localhost:8088/setup)
# can save the Deye access into data/secrets.json instead. Values set here win over that file.

# Deye Cloud account (the same login as the Deye Cloud app / deyecloud.com)
DEYE_EMAIL=
DEYE_PASSWORD=

# Deye Cloud Developer application (developer.deyecloud.com -> Application).
# Give it ONLY the monitoring permissions; this software never sends control commands.
DEYE_APP_ID=
DEYE_APP_SECRET=

# Data centre of the account: eu1 (Europe), us1 (Americas), india, ... see README
DEYE_BASE_URL=https://eu1-developer.deyecloud.com/v1.0

# Optional: pin the station / inverter, otherwise the collector picks the first one it finds
DEYE_STATION_ID=
DEYE_DEVICE_SN=

# Time zone of the installation (IANA name, e.g. Europe/Berlin). Empty = the one chosen in the
# setup, or the computer's own.
TZ=
DB_PATH=./data/pv.sqlite
# the collector asks every 5-7 minutes (base + random -30..+60 s, minimum 300)
POLL_INTERVAL_SECONDS=360
# pause between two calls to Deye (Deye answers HTTP 500 to bursts)
DEYE_MIN_INTERVAL=1.5
LOG_LEVEL=INFO
# dashboard port on the host (Docker Compose)
WEB_PORT=8088

# Database backup (guard service): host folder for the daily copies (keeps 7 days, 8 weeks, 12 months).
# Tip: a folder that is synced off the computer (Google Drive, OneDrive, iCloud Drive, Dropbox, a NAS).
BACKUP_DIR=./backups
# local hour after which the daily backup is made
BACKUP_HOUR=3

# Alerts: minutes without new data before it counts as a problem; repeat while it lasts
STALE_MINUTES=45
ALERT_REPEAT_HOURS=12
# Channels (optional; without them problems show only in the dashboard):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# e-mail over SMTP (port 587 with STARTTLS or 465 with SSL)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# ntfy topic URL, e.g. https://ntfy.sh/<long-random-name>
NTFY_URL=

# Password for changes in the dashboard (settings, invoices, goals, keys). Strongly recommended as
# soon as the dashboard is reachable from outside your home network. Requests from other web pages
# are always refused.
WRITE_PASSWORD=

# AI analysis (optional, see README). The key can also be entered on the Settings page.
# LLM_PROVIDER: anthropic | openai (any OpenAI-compatible API, incl. Ollama / LM Studio) | cli
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# For LLM_PROVIDER=cli: a command that reads the prompt on stdin and prints the answer,
# e.g. `claude -p` or `ollama run llama3.1`. Only settable here, never from the web page.
LLM_CLI_COMMAND=

# Access from outside (optional; docs/public-access.md). COMPOSE_PROFILES picks the way:
# funnel (Tailscale, free, no domain) or tunnel (Cloudflare, needs a domain).
COMPOSE_PROFILES=
TS_AUTHKEY=
TS_HOSTNAME=pvmon
TUNNEL_TOKEN=
# the public address; guard checks it every 5 minutes, e.g. https://pvmon.<tailnet>.ts.net
TUNNEL_PUBLIC_URL=
# for Funnel: http://funnel:9002/healthz (the default is for Cloudflare)
TUNNEL_READY_URL=
