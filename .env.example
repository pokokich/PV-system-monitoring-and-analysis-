# Копирай като .env (той е в .gitignore) и попълни локално. Никога не го комитвай.

# Deye Cloud акаунт (същият като за deyecloud.com)
DEYE_EMAIL=
DEYE_PASSWORD=

# Deye Cloud Developer приложение (developer.deyecloud.com -> Application)
DEYE_APP_ID=
DEYE_APP_SECRET=

# Регион на акаунта: eu1 за Европа
DEYE_BASE_URL=https://eu1-developer.deyecloud.com/v1.0

# По избор: фиксирай станция/инвертор, иначе колекторът ги открива сам
DEYE_STATION_ID=
DEYE_DEVICE_SN=

# Локални настройки
TZ=Europe/Sofia
DB_PATH=./data/pv.sqlite
# колекторът пита на 5–7 минути (база + случайни −30…+60 s, минимум 300)
POLL_INTERVAL_SECONDS=360
# пауза между две заявки към Deye (при бърза поредица Deye връща HTTP 500)
DEYE_MIN_INTERVAL=1.5
LOG_LEVEL=INFO
# порт на дашборда на хоста (Docker Compose)
WEB_PORT=8088

# Архив на базата (услугата guard): папка на хоста за ежедневните копия (пази 7 дни, 8 недели, 12 месеца).
# Препоръка: папка, която се синхронизира извън компютъра, например iCloud Drive на Mac:
# BACKUP_DIR=/Users/<потребител>/Library/Mobile Documents/com~apple~CloudDocs/deyehome-backups
BACKUP_DIR=./backups
# час (местно време), след който се прави дневният архив
BACKUP_HOUR=3

# Известия: след колко минути без нови данни е проблем; повторение на известието, докато проблемът трае
STALE_MINUTES=45
ALERT_REPEAT_HOURS=12
# Канали (по избор; без тях проблемите се виждат само в дашборда):
# Telegram бот
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# имейл през SMTP (порт 587 със STARTTLS или 465 с SSL)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# ntfy: адрес на тема, например https://ntfy.sh/<дълго-случайно-име>
NTFY_URL=

# Парола за промени в дашборда (настройки, фактури, цели). Празно = без парола;
# защитата срещу заявки от чужди страници е включена винаги.
WRITE_PASSWORD=

# Достъп отвън (по избор; описание: docs/08-public-access.md). COMPOSE_PROFILES избира начина и
# го включва при всяко `docker compose up -d --build`: funnel (Tailscale, без домейн) или tunnel (Cloudflare, с домейн).
COMPOSE_PROFILES=
# Tailscale Funnel: ключ от login.tailscale.com → Settings → Keys (нужен е само при първото пускане)
TS_AUTHKEY=
TS_HOSTNAME=pv-home
# Cloudflare Tunnel:
# токенът от Cloudflare Zero Trust → Networks → Tunnels → тунелът → Install connector (дългият низ след --token)
TUNNEL_TOKEN=
# публичният адрес, guard го проверява на всеки 5 минути, например https://pv-home.<tailnet>.ts.net
TUNNEL_PUBLIC_URL=
# за Funnel: http://funnel:9002/healthz (по подразбиране е за Cloudflare)
TUNNEL_READY_URL=
